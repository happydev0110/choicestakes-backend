NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info

# Exact origins, separated by commas. No trailing slash or wildcard.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://198.18.1.255:3000

# The API can run without MySQL while the backend is being configured.
# /health/ready returns 503 until MySQL is enabled and reachable.
DB_ENABLED=false
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=choicestacks_sandbox
MYSQL_USER=choicestacks_app
MYSQL_PASSWORD=
MYSQL_CONNECTION_LIMIT=10
MYSQL_SSL=false
# Optional path to your database provider's CA certificate (requires MYSQL_SSL=true).
MYSQL_SSL_CA=

# Sessions expire after 24 hours, or after 60 minutes without account activity.
SESSION_TTL_HOURS=24
SESSION_IDLE_MINUTES=60

# API-MATIC sandbox only. Keep play disabled until a public callback is ready.
# With keys configured, games:check and games:sync work even while play is disabled.
APIMATIC_ENABLED=false
# Import on backend startup and refresh in the background, even while play is disabled.
APIMATIC_SYNC_ENABLED=true
APIMATIC_SYNC_INTERVAL_MINUTES=15
# Paste the sandbox API key exactly as issued; do not add a prefix.
APIMATIC_API_KEY=
APIMATIC_SECRET_KEY=
APIMATIC_CALLBACK_URL=
# Example callback: https://api.yourdomain.com/api/v1/provider/apimatic/sandbox
# Use an exact currency enabled in your provider back office (EUR is a placeholder).
APIMATIC_CURRENCY=EUR
APIMATIC_CURRENCY_DECIMALS=2
APIMATIC_TEST_CREDITS=1000
# Never put secrets in the frontend or in NEXT_PUBLIC_* variables.
